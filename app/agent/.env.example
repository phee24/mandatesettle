# Network: testnet | mainnet | local
HSK_NETWORK=testnet
# RPC_URL=https://testnet.hsk.xyz

# Agent keys (NEVER commit real keys; the payer defaults to the project
# wallet file below when BUYER_PRIVATE_KEY is unset)
# BUYER_PRIVATE_KEY=0x...
SELLER_PRIVATE_KEY=0x...
# RELAYER_PRIVATE_KEY=0x...

# Project wallet (cast wallet JSON, mode 600) — payer for real runs
PROJECT_WALLET_FILE=/path/to/your/cast-wallet.json

# Buyer spend policy (human token units)
BUYER_MAX_PER_TX=50
BUYER_MAX_PER_DAY=200
TOKEN_DECIMALS=6
